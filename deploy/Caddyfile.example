# Caddy reverse-proxy config for serving RWND over HTTPS.
#
# Caddy obtains the certificates itself (via ACME) when the domains below
# really point at this machine, so no certbot/ssl_cert lines are needed.
# The app gets its own vhost so the page and the chat gateway WebSocket sit
# on one origin with Caddy's certificate in front.
#
#   caddy validate --config deploy/Caddyfile.example --adapter caddyfile
#   caddy -c deploy/Caddyfile.example
#
# Replace chat.example.com with your domain (e.g. rwnd.mimtiller.com) and the
# port with the one your install picked.

chat.example.com {
	# The RWND server: the web app at /, its pkg/ bundle, /media, the API and
	# the chat gateway WebSocket. Caddy upgrades WebSockets automatically.
	reverse_proxy 127.0.0.1:3000
}

# What Caddy does NOT reach: the idea-chat call relay speaks QUIC/WebTransport,
# which a reverse proxy cannot carry at all. Run the relay on its own and leave
# its https://host:port URL directly reachable — the client dials it without
# going through this config (docs/self-hosting.md explains the relay setup).

# TRUSTED_PROXIES: Caddy runs on this machine, so set
#   TRUSTED_PROXIES=127.0.0.1,::1
# in the RWND env so per-IP rate limits still work off X-Forwarded-For.
