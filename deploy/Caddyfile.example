# Caddy reverse-proxy config for serving RWND over HTTPS.
#
# Caddy obtains the certificates itself (via ACME) when the domain below
# really points at this machine, so no certbot/ssl_cert lines are needed.
#
#   caddy validate --config deploy/Caddyfile.example --adapter caddyfile
#   caddy -c deploy/Caddyfile.example
#
# Replace chat.example.com with your domain (e.g. rwnd.mimtiller.com) and the
# port with the one your install picked.

chat.example.com {
	# The RWND server: the web app at /, its pkg/ bundle, /media, the API and
	# the chat gateway WebSocket. Caddy upgrades WebSockets automatically.
	reverse_proxy 127.0.0.1:3000
}

# Voice and video do not go through Caddy: the idea-chat relay speaks QUIC
# over UDP (port 4433 by default), so forward that port to this machine on
# your router or firewall. The RWND server hands each client the relay's
# address and a signed grant.
#
# TRUSTED_PROXIES: Caddy runs on this machine, so set
#   TRUSTED_PROXIES=127.0.0.1,::1
# in the RWND env so per-IP rate limits still work off X-Forwarded-For.
