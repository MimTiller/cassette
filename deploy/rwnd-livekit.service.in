# systemd --user unit for the LiveKit server. deploy/install.sh fills the
# __PLACEHOLDERS__ below and writes ~/.config/systemd/user/rwnd-livekit.service.
[Unit]
Description=LiveKit server for RWND voice (installed by deploy/install.sh)
After=network-online.target

[Service]
ExecStart=__PREFIX__/bin/livekit-server --config __PREFIX__/livekit.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
